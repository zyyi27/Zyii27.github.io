# Salin menjadi .env atau atur sebagai variabel lingkungan di layanan hosting.
PORT=3000
# Folder penyimpanan data. Arahkan ke disk/volume PERMANEN.
DATA_DIR=./data
# PIN admin awal (hanya dipakai saat server pertama kali dijalankan). Ganti lagi lewat aplikasi.
ADMIN_PIN=ganti-dengan-pin-anda
# Isi 1 jika server berada di belakang proxy HTTPS (Nginx, Cloudflare, Railway, Render).
TRUST_PROXY=1
